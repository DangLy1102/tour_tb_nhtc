# Copy thành .env.local khi chạy máy, hoặc dán vào Vercel → Settings → Environment Variables.
# Không commit mật khẩu thật. DATABASE_URL lấy từ Neon sau khi gắn Storage trên Vercel.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ALLOWED_EMAIL_DOMAIN=nhtc.com.vn
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NHTC Tour <no-reply@nhtc.com.vn>
